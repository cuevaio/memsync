{
  "name": "memsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@memsync/web",
    "build:extension": "turbo run build --filter=@memsync/extension",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@memsync/web",
    "start:web": "bun --filter=@memsync/web run start",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  }
}
